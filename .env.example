# HealthLink environment configuration.
#
# Copy to `.env.local` and set a real secret before any non-demonstration use.
# `.env.local` is git-ignored, so a connection string put there never enters git.

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------

# Secret used to sign session JWTs (HS256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Required in any deployment. Without it, HealthLink falls back to a development
# default that is published in this repository, and sessions could be forged.
HEALTHLINK_SECRET=change-me-before-any-real-use

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Leave DATABASE_URL unset to use SQLite (a file at data/healthlink.db). That is
# the default: zero configuration, and enough for local development and offline
# evaluation.
#
# Set it to a PostgreSQL URL to use Postgres instead. This is REQUIRED for
# serverless hosting (Vercel and similar), where the filesystem is read-only and
# SQLite cannot persist a write.
#
# Use the POOLED connection string for the application. A direct (unpooled) URL
# is only needed for migrations and administrative work.
#
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Connection pool size (default 4). Deliberately small: serverless instances are
# short-lived and the pooler multiplexes, so a large per-instance pool would only
# exhaust the server's connection limit.
# PGPOOL_MAX=4

# Overrides the SQLite file path. The test suite sets this so a test run cannot
# touch the demonstration database.
# HEALTHLINK_DB=./data/healthlink.db

# Must be "1" before the test suite will run against Postgres at all, because the
# suite deletes and re-seeds every table.
# HEALTHLINK_TEST_POSTGRES=1

# ---------------------------------------------------------------------------
# FHIR
# ---------------------------------------------------------------------------

# Public base URL of the FHIR facade, used in Bundle fullUrl values and in the
# CapabilityStatement. Defaults to http://localhost:3000/fhir when unset.
# Set this to the deployed origin so that returned resources carry absolute URLs
# resolvable by a third-party client.
# HEALTHLINK_FHIR_BASE=https://your-deployment.example/fhir
