{
  "name": "healthlink",
  "version": "0.1.0",
  "private": true,
  "description": "HealthLink - An Interoperable Patient Referral and Health Information Exchange System for Davao City",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "check:promises": "tsx scripts/check-floating-promises.mts",
    "db:reset": "tsx scripts/db-reset.mts",
    "db:reset:sqlite": "tsx scripts/db-reset.mts --sqlite",
    "test": "tsx scripts/check-floating-promises.mts && tsx scripts/test-fhir.mts",
    "test:fhir": "tsx scripts/test-fhir.mts",
    "test:postgres": "tsx scripts/test-postgres.mts",
    "verify:postgres": "tsx scripts/verify-postgres.mts",
    "verify:http": "tsx scripts/verify-http-postgres.mts",
    "demo:state": "tsx scripts/dump-demo-state.mts",
    "demo:data": "tsx scripts/report-seed-data.mts",
    "terminology:check": "tsx scripts/check-terminology.mts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
